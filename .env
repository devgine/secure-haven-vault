# Valeurs par défaut versionnées — AUCUN secret réel ici.
# Les vraies valeurs vivent dans .env.local (non versionné) :
#
#   docker compose --env-file .env --env-file .env.local up -d --build
#
# À renseigner dans .env.local :
#   MASTER_ENCRYPTION_KEY   openssl rand -hex 32
#   POSTGRES_PASSWORD
#   POSTGRES_EXPORTER_PASSWORD
#   ADMIN_PASSWORD          12 caractères minimum

# DATABASE_URL="postgres://user:password@hote:5432/vault"
ADMIN_EMAIL="admin@securevault.localhost"
ADMIN_PASSWORD=""
APP_DOMAIN="securevault.localhost"
MASTER_ENCRYPTION_KEY=""
POSTGRES_DB="vault"
POSTGRES_PASSWORD="changeme"
POSTGRES_USER="vault"
POSTGRES_EXPORTER_PASSWORD="changeme"
POSTGRES_EXPORTER_USER="exporter"
PROJECT_NAME="securevault"
TRAEFIK_NETWORK="traefik-network"
