PROJECT_NAME=securevault
TRAEFIK_NETWORK=traefik-network
APP_DOMAIN=securevault.localhost

# ── Sentinel Vault — configuration Docker (à copier dans .env) ───────────────

# Clé maître de chiffrement AES-256-GCM des secrets (obligatoire).
# Générez-en une nouvelle :  openssl rand -hex 32
# ATTENTION : sans la clé d'origine, les secrets chiffrés existants sont
# indéchiffrables. Conservez-la dans un coffre hors de ce serveur.
MASTER_ENCRYPTION_KEY=

# Port exposé de l'application sur l'hôte
APP_PORT=3000

# PostgreSQL local (utilisé pour construire DATABASE_URL côté conteneur app)
POSTGRES_USER=vault
POSTGRES_PASSWORD=changeme
POSTGRES_DB=vault

# Optionnel — si vous pointez l'application vers un PostgreSQL EXTERNE,
# décommentez et renseignez la chaîne complète (remplace le service db) :
# DATABASE_URL=postgres://user:password@hote:5432/vault
