# ── Sentinel Vault — configuration Docker (à copier dans .env) ───────────────

# Backend API (Lovable Cloud managé, ou votre passerelle Supabase auto-hébergée)
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_PROJECT_ID=

# Clé service (serveur uniquement — administration, OIDC, opérations privilégiées).
# Non disponible sur Lovable Cloud : laissez vide, ou utilisez la clé de votre
# stack Supabase auto-hébergée.
SUPABASE_SERVICE_ROLE_KEY=

# Clé maître de chiffrement AES-256-GCM des secrets (obligatoire).
# Générez-en une nouvelle :  openssl rand -hex 32
# ATTENTION : sans la clé d'origine, les secrets chiffrés existants sont
# indéchiffrables. Conservez-la dans un coffre hors de ce serveur.
MASTER_ENCRYPTION_KEY=

# Port exposé de l'application sur l'hôte
APP_PORT=3000

# PostgreSQL local
POSTGRES_USER=vault
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=vault
