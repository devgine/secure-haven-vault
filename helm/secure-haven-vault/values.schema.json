{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "image": {
      "type": "object",
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "not": {"const": "latest"}},
        "digest": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      },
      "required": ["repository", "pullPolicy"]
    },
    "config": {
      "type": "object",
      "properties": {
        "appUrl": {"type": "string", "pattern": "^(https?://.+)?$"},
        "trustProxy": {"type": "boolean"},
        "masterEncryptionKey": {"type": "string"},
        "existingSecret": {"type": "string"},
        "auditRetentionDays": {"type": "integer", "minimum": 0},
        "admin": {
          "type": "object",
          "properties": {
            "email": {"type": "string"},
            "password": {"type": "string"},
            "passwordKey": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "cnpgOperatorNamespace": {"type": "string", "minLength": 1}
      }
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "instances": {"type": "integer", "minimum": 1},
        "auth": {
          "type": "object",
          "properties": {
            "username": {"type": "string", "minLength": 1},
            "database": {"type": "string", "minLength": 1},
            "password": {"type": "string"},
            "existingSecret": {"type": "string"}
          }
        }
      }
    },
    "externalDatabase": {
      "type": "object",
      "properties": {"url": {"type": "string"}}
    }
  }
}
